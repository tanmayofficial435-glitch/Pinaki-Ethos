{
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/admin-auth.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/management",
      "destination": "/internal/management.html"
    }
  ],
  "headers": [
    {
      "source": "/management",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/internal/management.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
